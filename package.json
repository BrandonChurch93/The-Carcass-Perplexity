{
  "name": "the-carcass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Carcass: a narrated film of about three minutes, every frame computed in three.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "test": "vitest run",
    "caps": "node tools/caps.mjs",
    "budget": "node tools/budget.mjs",
    "clock": "node tools/clock.mjs",
    "look": "node tools/look.mjs",
    "progress": "node tools/progress.mjs",
    "private": "node tools/private.mjs",
    "status": "node tools/status.mjs",
    "still": "node tools/still.mjs",
    "crops": "node tools/crops.mjs",
    "compare": "node tools/compare.mjs",
    "sheet": "node tools/sheet.mjs",
    "determinism": "node tools/determinism.mjs",
    "gate": "node tools/gate.mjs",
    "keep": "node tools/keep.mjs",
    "review": "node tools/review.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "playwright-core": "1.59.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
