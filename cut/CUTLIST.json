  "lines": [
    {
      "clip": "n1",
      "line": 1,
      "text": "Listen.",
      "unit": "ribs",
      "first": 84,
      "frames": 54,
      "file": null,
      "carried": false
    },
    {
      "clip": "n1",
      "line": 2,
      "text": "There is a land the maps leave empty.",
      "unit": "ribs",
      "first": 240,
      "frames": 234,
      "file": null,
      "carried": false
    },
    {
      "clip": "n1",
      "line": 3,
      "text": "I have walked it. End to end.",
      "unit": "ribs",
      "first": 546,
      "frames": 213,
      "file": null,
      "carried": false
    },
    {
      "clip": "n1",
      "line": 4,
      "text": "I will tell you what is there.",
      "unit": "ribs",
      "first": 825,
      "frames": 189,
      "file": null,
      "carried": false
    },
    {
      "clip": "n2",
      "line": 1,
      "text": "The strait.",
      "unit": "ribs",
      "first": 1077,
      "frames": 70,
      "file": null,
      "carried": false
    },
    {
      "clip": "n2",
      "line": 2,
      "text": "Stone ribs. Taller than any wall men have built.",
      "unit": "ribs",
      "first": 1194,
      "frames": 333,
      "file": null,
      "carried": false
    },
    {
      "clip": "n2",
      "line": 3,
      "text": "At low tide, the winged things come down to feed.",
      "unit": "ribs",
      "first": 1572,
      "frames": 321,
      "file": null,
      "carried": false
    },
    {
      "clip": "n2",
      "line": 4,
      "text": "Look up. The drowned hang in the weed. That is how high the sea returns.",
      "unit": "ribs",
      "first": 1938,
      "frames": 514,
      "file": null,
      "carried": false
    },
    {
      "clip": "n3",
      "line": 1,
      "text": "The fire.",
      "unit": "heart",
      "first": 2550,
      "frames": 57,
      "file": null,
      "carried": false
    },
    {
      "clip": "n3",
      "line": 2,
      "text": "A lake of it, under a black skin.",
      "unit": "heart",
      "first": 2658,
      "frames": 220,
      "file": null,
      "carried": false
    },
    {
      "clip": "n3",
      "line": 3,
      "text": "The tall ones walk the skin, and drink from the cracks.",
      "unit": "heart",
      "first": 2964,
      "frames": 359,
      "file": null,
      "carried": false
    },
    {
      "clip": "n3",
      "line": 4,
      "text": "It burned before there were men. It will burn after.",
      "unit": "heart",
      "first": 3420,
      "frames": 358,
      "file": null,
      "carried": false
    },
    {
      "clip": "n4",
      "line": 1,
      "text": "The pits.",
      "unit": "breath",
      "first": 4257,
      "frames": 57,
      "file": null,
      "carried": false
    },
    {
      "clip": "n4",
      "line": 2,
      "text": "The land breathes here. Slow. From far below.",
      "unit": "breath",
      "first": 4368,
      "frames": 344,
      "file": null,
      "carried": false
    },
    {
      "clip": "n4",
      "line": 3,
      "text": "Nothing grows near them but the red weed.",
      "unit": "breath",
      "first": 4758,
      "frames": 259,
      "file": null,
      "carried": false
    },
    {
      "clip": "n4",
      "line": 4,
      "text": "The pale herds feed, and keep their distance. They are wiser than men.",
      "unit": "breath",
      "first": 5070,
      "frames": 483,
      "file": null,
      "carried": false
    },
    {
      "clip": "n5",
      "line": 1,
      "text": "The red flats.",
      "unit": "marsh",
      "first": 5676,
      "frames": 89,
      "file": null,
      "carried": false
    },
    {
      "clip": "n5",
      "line": 2,
      "text": "It was blood once. It still seeps.",
      "unit": "marsh",
      "first": 5892,
      "frames": 245,
      "file": null,
      "carried": false
    },
    {
      "clip": "n5",
      "line": 3,
      "text": "The great beasts wallow in it, and grow fat.",
      "unit": "marsh",
      "first": 6285,
      "frames": 290,
      "file": null,
      "carried": false
    },
    {
      "clip": "n5",
      "line": 4,
      "text": "The salt keeps what it catches. Forever.",
      "unit": "marsh",
      "first": 6636,
      "frames": 282,
      "file": null,
      "carried": false
    },
    {
      "clip": "n6",
      "line": 1,
      "text": "The ridge.",
      "unit": "spine",
      "first": 7056,
      "frames": 63,
      "file": null,
      "carried": false
    },
    {
      "clip": "n6",
      "line": 2,
      "text": "Above the clouds. Above the storm.",
      "unit": "spine",
      "first": 7164,
      "frames": 245,
      "file": null,
      "carried": false
    },
    {
      "clip": "n6",
      "line": 3,
      "text": "Lightning walks it every night. Spire to spire.",
      "unit": "spine",
      "first": 7458,
      "frames": 327,
      "file": null,
      "carried": false
    },
    {
      "clip": "n6",
      "line": 4,
      "text": "The beasts sleep inside the bone, and wait for morning.",
      "unit": "spine",
      "first": 7896,
      "frames": 359,
      "file": null,
      "carried": false
    },
    {
      "clip": "n7",
      "line": 1,
      "text": "The lake.",
      "unit": "eye",
      "first": 8337,
      "frames": 57,
      "file": null,
      "carried": false
    },
    {
      "clip": "n7",
      "line": 2,
      "text": "Still. Gold at the edge. Black at the center.",
      "unit": "eye",
      "first": 8466,
      "frames": 344,
      "file": null,
      "carried": false
    },
    {
      "clip": "n7",
      "line": 3,
      "text": "The herds drink there. They do not look down.",
      "unit": "eye",
      "first": 8847,
      "frames": 314,
      "file": null,
      "carried": false
    },
    {
      "clip": "n7",
      "line": 4,
      "text": "The center has no bottom. I did not find one.",
      "unit": "eye",
      "first": 9204,
      "frames": 314,
      "file": null,
      "carried": false
    },
    {
      "clip": "n8",
      "line": 1,
      "text": "Now you see it.",
      "unit": "reveal",
      "first": 9741,
      "frames": 121,
      "file": "audio/kept/lines/n8-1.wav",
      "carried": false
    },
    {
      "clip": "n8",
      "line": 2,
      "text": "This was never land.",
      "unit": "reveal",
      "first": 9900,
      "frames": 111,
      "file": "audio/kept/lines/n8-2.wav",
      "carried": false
    },
    {
      "clip": "n8",
      "line": 3,
      "text": "It was a god.",
      "unit": "reveal",
      "first": 10075,
      "frames": 75,
      "file": "audio/kept/lines/n8-3.wav",
      "carried": false
    },
    {
      "clip": "n8",
      "line": 4,
      "text": "Gods die slow. This one is not finished.",
      "unit": "reveal",
      "first": 10620,
      "frames": 270,
      "file": "audio/kept/lines/n8-4.wav",
      "carried": false
    }
  ],
