  "lines": [
    {
      "clip": "n1",
      "line": 1,
      "text": "Past the last calm water, there is a shore.",
      "unit": "ribs",
      "first": 84,
      "frames": 246,
      "file": "audio/kept/lines/n1-1.wav",
      "carried": false
    },
    {
      "clip": "n1",
      "line": 2,
      "text": "Nothing on it has a name.",
      "unit": "ribs",
      "first": 432,
      "frames": 122,
      "file": "audio/kept/lines/n1-2.wav",
      "carried": false
    },
    {
      "clip": "n1",
      "line": 3,
      "text": "Nothing on it should be alive.",
      "unit": "ribs",
      "first": 654,
      "frames": 144,
      "file": "audio/kept/lines/n1-3.wav",
      "carried": false
    },
    {
      "clip": "n1",
      "line": 4,
      "text": "All of it is.",
      "unit": "ribs",
      "first": 930,
      "frames": 87,
      "file": "audio/kept/lines/n1-4.wav",
      "carried": false
    },
    {
      "clip": "n2",
      "line": 1,
      "text": "The strait.",
      "unit": "ribs",
      "first": 1074,
      "frames": 71,
      "file": "audio/kept/lines/n2-1.wav",
      "carried": false
    },
    {
      "clip": "n2",
      "line": 2,
      "text": "Stone blades, taller than the storms.",
      "unit": "ribs",
      "first": 1188,
      "frames": 217,
      "file": "audio/kept/lines/n2-2.wav",
      "carried": false
    },
    {
      "clip": "n3",
      "line": 1,
      "text": "The fire.",
      "unit": "heart",
      "first": 2550,
      "frames": 67,
      "file": "audio/kept/lines/n3-1.wav",
      "carried": false
    },
    {
      "clip": "n3",
      "line": 2,
      "text": "A lake of it, under a black skin.",
      "unit": "heart",
      "first": 2658,
      "frames": 200,
      "file": "audio/kept/lines/n3-2.wav",
      "carried": false
    },
    {
      "clip": "n3",
      "line": 3,
      "text": "The tall ones walk the skin, and drink from the cracks.",
      "unit": "heart",
      "first": 2964,
      "frames": 269,
      "file": "audio/kept/lines/n3-3.wav",
      "carried": false
    },
    {
      "clip": "n4",
      "line": 1,
      "text": "The pits.",
      "unit": "breath",
      "first": 4257,
      "frames": 80,
      "file": "audio/kept/lines/n4-1.wav",
      "carried": false
    },
    {
      "clip": "n4",
      "line": 2,
      "text": "The ground breathes here. Slow. From far below.",
      "unit": "breath",
      "first": 4374,
      "frames": 314,
      "file": "audio/kept/lines/n4-2.wav",
      "carried": false
    },
    {
      "clip": "n5",
      "line": 1,
      "text": "The red flats.",
      "unit": "marsh",
      "first": 5655,
      "frames": 96,
      "file": "audio/kept/lines/n5-1.wav",
      "carried": false
    },
    {
      "clip": "n5",
      "line": 2,
      "text": "Stalks root in the red. The ground still bleeds.",
      "unit": "marsh",
      "first": 5832,
      "frames": 300,
      "file": "audio/kept/lines/n5-2.wav",
      "carried": false
    },
    {
      "clip": "n5",
      "line": 3,
      "text": "The heavy ones wallow in it, and grow fat.",
      "unit": "marsh",
      "first": 6288,
      "frames": 228,
      "file": "audio/kept/lines/n5-3.wav",
      "carried": false
    },
    {
      "clip": "n6",
      "line": 1,
      "text": "The ridge.",
      "unit": "spine",
      "first": 7035,
      "frames": 65,
      "file": "audio/kept/lines/n6-1.wav",
      "carried": false
    },
    {
      "clip": "n6",
      "line": 2,
      "text": "Above the cloud. Under the storm.",
      "unit": "spine",
      "first": 7137,
      "frames": 207,
      "file": "audio/kept/lines/n6-2.wav",
      "carried": false
    },
    {
      "clip": "n6",
      "line": 3,
      "text": "Every night the lightning walks it. Spire to spire.",
      "unit": "spine",
      "first": 7500,
      "frames": 268,
      "file": "audio/kept/lines/n6-3.wav",
      "carried": false
    },
    {
      "clip": "n7",
      "line": 1,
      "text": "The lake.",
      "unit": "eye",
      "first": 8337,
      "frames": 60,
      "file": "audio/kept/lines/n7-1.wav",
      "carried": false
    },
    {
      "clip": "n7",
      "line": 2,
      "text": "Still. Gold at the edge. Black at the center.",
      "unit": "eye",
      "first": 8478,
      "frames": 306,
      "file": "audio/kept/lines/n7-2.wav",
      "carried": false
    },
    {
      "clip": "n8",
      "line": 1,
      "text": "The land has a shape.",
